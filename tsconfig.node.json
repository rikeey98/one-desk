{
  "extends": "./tsconfig.base.json",
  "include": ["electron/**/*", "core/**/*", "shared/**/*", "*.config.ts"],
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node", "electron"],
    "baseUrl": ".",
